<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#fff7f5">
    <title>Cuenta regresiva para verte</title>
    <style>
        :root {
            color-scheme: light;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #49323d;
            background: #fff7f5;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            min-height: 100svh;
            margin: 0;
            display: grid;
            place-items: center;
            overflow: hidden;
            padding: 24px;
            background:
                radial-gradient(ellipse at 15% 18%, rgba(255, 208, 213, .65), transparent 38%),
                radial-gradient(ellipse at 88% 85%, rgba(255, 224, 196, .68), transparent 40%),
                #fff7f5;
        }

        main {
            position: relative;
            width: min(100%, 620px);
            padding: clamp(32px, 8vw, 64px) clamp(20px, 7vw, 56px);
            text-align: center;
            background: rgba(255, 255, 255, .82);
            border: 1px solid rgba(255, 255, 255, .95);
            border-radius: 32px;
            box-shadow: 0 24px 70px rgba(128, 73, 91, .13);
            backdrop-filter: blur(12px);
        }

        .eyebrow {
            margin: 0 0 14px;
            color: #b46d7d;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .2em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            color: #713e51;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(2.35rem, 8vw, 4rem);
            font-weight: 400;
            line-height: 1.08;
        }

        .message {
            margin: 18px auto 0;
            color: #806d73;
            font-size: clamp(1rem, 3vw, 1.12rem);
            line-height: 1.65;
        }

        .destination {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 22px;
            padding: 9px 16px;
            color: #8d5262;
            background: #fff0f0;
            border-radius: 999px;
            font-size: .95rem;
            font-weight: 600;
        }

        .countdown {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: clamp(8px, 2vw, 16px);
            margin-top: 38px;
        }

        .unit {
            min-width: 0;
            padding: 18px 8px 15px;
            background: #fff8f6;
            border: 1px solid #f8e9e8;
            border-radius: 18px;
        }

        .value {
            display: block;
            color: #a6536a;
            font-variant-numeric: tabular-nums;
            font-size: clamp(1.8rem, 7vw, 2.8rem);
            font-weight: 700;
            line-height: 1;
        }

        .label {
            display: block;
            margin-top: 9px;
            color: #9b858a;
            font-size: clamp(.65rem, 2.5vw, .78rem);
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .date {
            margin: 26px 0 0;
            color: #a58f94;
            font-size: .9rem;
        }

        .heart {
            display: inline-block;
            margin-top: 23px;
            color: #dc8190;
            font-size: 1.35rem;
            animation: heartbeat 1.8s ease-in-out infinite;
        }

        .arrived .countdown {
            display: none;
        }

        .arrived .message {
            color: #a6536a;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(1.45rem, 5vw, 2rem);
        }

        @keyframes heartbeat {
            50% { transform: scale(1.18); }
        }

        @media (max-width: 380px) {
            body { padding: 14px; }
            main { border-radius: 24px; }
            .unit { padding: 15px 4px 13px; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>
<body>
    <main id="countdown-card">
        <p class="eyebrow">Cada vez falta menos</p>
        <h1>Ya quiero verte</h1>
        <p class="message" id="message">Estoy contando los días para abrazarte.</p>
        <div class="destination"><span aria-hidden="true">📍</span> Nos vemos en MTY</div>

        <section class="countdown" aria-label="Tiempo restante">
            <div class="unit"><span class="value" id="days">00</span><span class="label">Días</span></div>
            <div class="unit"><span class="value" id="hours">00</span><span class="label">Horas</span></div>
            <div class="unit"><span class="value" id="minutes">00</span><span class="label">Minutos</span></div>
            <div class="unit"><span class="value" id="seconds">00</span><span class="label">Segundos</span></div>
        </section>

        <p class="date">30 de octubre de 2026</p>
        <span class="heart" aria-hidden="true">♥</span>
    </main>

    <script>
        const arrival = new Date(2026, 9, 30);
        const card = document.getElementById("countdown-card");
        const message = document.getElementById("message");
        const units = {
            days: document.getElementById("days"),
            hours: document.getElementById("hours"),
            minutes: document.getElementById("minutes"),
            seconds: document.getElementById("seconds")
        };

        function updateCountdown() {
            const remaining = arrival.getTime() - Date.now();

            if (remaining <= 0) {
                card.classList.add("arrived");
                message.textContent = "¡Hoy por fin nos vemos! Te espero con muchas ganas. ♥";
                return;
            }

            const seconds = Math.floor(remaining / 1000);
            units.days.textContent = String(Math.floor(seconds / 86400)).padStart(2, "0");
            units.hours.textContent = String(Math.floor((seconds % 86400) / 3600)).padStart(2, "0");
            units.minutes.textContent = String(Math.floor((seconds % 3600) / 60)).padStart(2, "0");
            units.seconds.textContent = String(seconds % 60).padStart(2, "0");
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
    </script>
</body>
</html>
